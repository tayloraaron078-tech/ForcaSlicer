# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# [regional-supports fork] Forca Slicer rebrand: SLIC3R_APP_NAME is the DISPLAYED name (window title, About,
# G-code header). SLIC3R_APP_KEY is the INTERNAL identity and MUST stay "OrcaSlicer" — it names the config file
# (OrcaSlicer.conf), the translation catalog (OrcaSlicer.mo) and the .3mf "Application" tag. The settings FOLDER is
# NOT this key: Forca uses its own (ForcaSlicer, GUI_App.cpp FORCA_DATA_DIR_NAME) and offers to copy Orca's once.
# The 3MF back-compat version tags are hardcoded "OrcaSlicer" literals (bbs_3mf.cpp), independent of this name.
set(SLIC3R_APP_NAME "Forca Slicer")
set(SLIC3R_APP_KEY "OrcaSlicer")

if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
set(SoftFever_VERSION "2.5.0-dev")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       SoftFever_VERSION_MATCH ${SoftFever_VERSION})
set(ORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(ORCA_VERSION_PATCH ${CMAKE_MATCH_3})

set(SLIC3R_VERSION "02.08.01.55")

# [regional-supports fork] Forca's OWN version (public-alpha B3): what users see (title/About/splash, G-code header,
# installer, release zip) and what the update check compares against Forca's GitHub release tags (vX.Y.Z[-pre.N]).
# SLIC3R_VERSION / SoftFever_VERSION above stay Orca's: profiles, .3mf files, config migration and the Bambu plugin
# compare against them. Keep the G-code header's version one word (Moonraker/Klipper parse "<name> <version> on").
set(FORCA_VERSION "0.1.0-alpha.3+porpoise.20261007")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" FORCA_VERSION_MATCH ${FORCA_VERSION})
set(FORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(FORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(FORCA_VERSION_PATCH ${CMAKE_MATCH_3})

if (NOT DEFINED ORCA_UPDATER_SIG_KEY)
    set(ORCA_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
